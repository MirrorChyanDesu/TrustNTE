<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Version>0.0.10</Version>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>TrustNTE.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\titlelogo.ico</ApplicationIcon>

		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="TrustNTE.update\**\*.cs" />
		<EmbeddedResource Remove="TrustNTE.update\**\*" />
		<None Remove="TrustNTE.update\**\*" />
		<!--     加入这三行，彻底把测试项目赶出主项目 -->
		<Compile Remove="TrustNTE.Tests\**\*.cs" />
		<EmbeddedResource Remove="TrustNTE.Tests\**\*" />
		<None Remove="TrustNTE.Tests\**\*" />
	</ItemGroup>

	<ItemGroup>
		<!-- Yolo模型文件 -->
		<None Update="Assets\NTE-CombatYOLO\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!--  UID 图集 -->
		<None Update="Assets\Nte_Uid\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!--  登录界面图集 -->
		<None Update="Assets\Nte_login_screen\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!--  启动器图集 -->
		<None Update="Assets\Nte_Launcher\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Nte_Data 图集 -->
		<None Update="Assets\Nte_Data\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- 模型文件被复制到 bin 目录 -->
		<None Update="Assets\NTE-Ocr_Models\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!--模板图被复制到 bin 目录，允许 OpenCV 读取 -->
		<Content Include="Views\Pages\TaskModules\Assets\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Pages\TaskModules\Assets\*.bmp">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- 确保触发器 UI 模板图被复制到 bin 目录 -->
		<Content Include="Services\Triggers\Assets\*.bmp">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- 翻译文件复制 -->
		<None Update="Assets\Translations\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!--  强制复制 Docs 目录下的所有文件 -->
		<None Remove="Assets\Docs\**\*.*" />
		<Content Include="Assets\Docs\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>


		<!-- Assets 目录下的所有资源都复制到输出目录 -->
		<None Update="Assets\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>


	</ItemGroup>
	<ItemGroup>
		<!-- Assets Psd文件不复制 里面全是图集源码 可以自己编辑 -->
		<None Remove="Assets\Psd\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Markdig" Version="1.5.1" />
		<PackageReference Include="MarkdView" Version="1.0.12" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
		<PackageReference Include="MouseKeyHook" Version="5.7.1" />
		<PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
		<PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
		<PackageReference Include="RapidOCRSharpOnnx" Version="1.3.1" />
		<PackageReference Include="Sdcb.OpenVINO" Version="0.8.1" />
		<PackageReference Include="Sdcb.OpenVINO.Extensions.OpenCvSharp4" Version="0.7.0" />
		<PackageReference Include="Sdcb.OpenVINO.runtime.win-x64" Version="2026.2.0" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
	</ItemGroup>



	<!-- WPF 界面资源文件编译 -->
	<ItemGroup>
		<Resource Include="Assets\TrustNTE.png" />
		<Resource Include="Assets\TrustNTE1.png" />
		<Resource Include="Assets\TrustNTE2.png" />
		<Resource Include="Assets\TrustNTE3.png" />
		<Resource Include="Assets\icon_api.png" />
		<Resource Include="Assets\titlelogo.ico" />

		<Resource Include="Views\Pages\TaskModules\Assets\**\*.png" />
		<Resource Include="Views\Pages\TaskModules\Assets\**\*.jpg" />
		<Resource Include="Views\Pages\TaskModules\Assets\**\*.jpeg" />
		<Resource Include="Views\Pages\TaskModules\Assets\**\*.bmp" />
		<Resource Include="Views\Pages\TaskModules\Assets\**\*.gif" />
		<Resource Include="Views\Pages\TaskModules\Assets\**\*.ico" />

		<Resource Include="Views\Windows\Assets\**\*.png" />
		<Resource Include="Views\Windows\Assets\**\*.jpg" />
		<Resource Include="Views\Windows\Assets\**\*.jpeg" />
		<Resource Include="Views\Windows\Assets\**\*.bmp" />
		<Resource Include="Views\Windows\Assets\**\*.gif" />
		<Resource Include="Views\Windows\Assets\**\*.ico" />
	</ItemGroup>

	<Target Name="BuildAndCopyUpdater" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)TrustNTE.update\TrustNTE.update.csproj')">
		<MSBuild Projects="$(MSBuildThisFileDirectory)TrustNTE.update\TrustNTE.update.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" />
		<ItemGroup>

			<UpdaterOutput Include="$(MSBuildThisFileDirectory)TrustNTE.update\bin\x64\$(Configuration)\net8.0-windows10.0.22621.0\TrustNTE.update.*" />
		</ItemGroup>
		<Copy SourceFiles="@(UpdaterOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>