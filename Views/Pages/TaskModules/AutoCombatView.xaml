<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoCombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '自动战斗'}" 
                                     Description="{helpers:Trans 'AI 识别敌人并自动打怪'}" 
                                     IconImage="Assets/hunt_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{helpers:Trans '启动'}" Command="{Binding StartCommand}" Width="72"  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="{helpers:Trans '停止'}" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="识别置信度" Description="检测敌人的阈值 (0.0 - 1.0)">
                <ui:NumberBox Value="{Binding Config.ConfidenceThreshold}" MaxDecimalPlaces="2" MinWidth="120" />
            </controls:SettingItem>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="使用终结技" Description="是否自动释放 Q 技能">
                <ui:ToggleSwitch IsChecked="{Binding Config.UseUltimate}" />
            </controls:SettingItem>
        </StackPanel>
    </ui:CardExpander>
</UserControl>