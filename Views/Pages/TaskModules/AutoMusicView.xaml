<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoMusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             xmlns:local="clr-namespace:TrustNTE.Views.Pages.TaskModules">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '自动音游'}" Description="自动演奏、循环挑战" IconImage="Assets/music_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:HyperlinkButton Content="文档" Command="{Binding OpenLogicDocCommand}" Icon="{ui:SymbolIcon BookQuestionMark24}" Margin="0,0,16,0"/>
                        <ui:Button Content="启动" Command="{Binding StartCommand}" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="停止" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

            <!-- 提示 -->
            <Grid Margin="16,10">
                <ui:TextBlock Text="提示:漏键或者成功率低↗↗↗↗↗点击上面的文档 " Foreground="{ui:ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>
            </Grid>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

            <!-- 循环与自动开始 -->
            <controls:SettingItem Title="循环与开始" Description="0为无限循环">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="循环次数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.LoopCount}" MinWidth="80" Margin="0,0,15,0" ClearButtonEnabled="True" />
                    <ui:ToggleSwitch IsChecked="{Binding Config.AutoClickStart}" Content="自动点击【开始演奏】" VerticalAlignment="Center"/>
                </StackPanel>
            </controls:SettingItem>

            <!-- 按键自定义 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="按键D F J K" Description="可自行修改键位">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="D:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:TextBox Text="{Binding Config.KeyD, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="F:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:TextBox Text="{Binding Config.KeyF, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="J:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:TextBox Text="{Binding Config.KeyJ, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="K:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:TextBox Text="{Binding Config.KeyK, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                </StackPanel>
            </controls:SettingItem>

            <!-- 判定参数 1：触发与复位（像素级） -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="触发与复位" Description="基于特征像素个数判定">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="触发像素:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.HitPixelCount}" MinWidth="60" Margin="0,0,20,0"
                                  ToolTip="判定圈内出现多少特征像素触发按键。调大防误触，调小更灵敏。"/>

                    <ui:TextBlock Text="复位像素:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.ResetPixelCount}" MinWidth="60" Margin="0,0,20,0"
                                  ToolTip="特征像素降到多少以下允许再次按键。调大防连按。"/>

                    <ui:TextBlock Text="强制复位ms:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.ForceResetMs}" MinWidth="60" Margin="0,0,20,0"
                                  ToolTip="超时强制解锁。如果动画太长导致漏键，可调小。"/>

                    <ui:TextBlock Text="V≤:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.DarkVHi}" MinWidth="60"
                                  ToolTip="黑色判定上限。0为纯黑，255为纯白。推荐 30~80。"/>
                </StackPanel>
            </controls:SettingItem>

            <!-- 判定参数 2：响应与间隔 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="响应与间隔" Description="调节按键频率与侦测范围">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="间隔ms:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.MinFireGapMs}" MinWidth="60" Margin="0,0,20,0"
                                  ToolTip="两次按键之间的最小物理间隔。防止高频连按吞键。"/>

                    <ui:TextBlock Text="按住ms:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.KeyDownTimeMs}" MinWidth="60" Margin="0,0,20,0"
                                  ToolTip="模拟按键按住的时间。太短(如5ms)有些引擎会判定无效。"/>

                    <ui:TextBlock Text="半径:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ui:NumberBox Value="{Binding Config.ObserveRadius}" MinWidth="60"
                                  ToolTip="侦测范围。半径越大，能抓到的区域越广。"/>
                </StackPanel>
            </controls:SettingItem>

            <!-- 调试页面 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="调试页面" Description="打开后纯画面显示，滚轮调字号">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:ToggleSwitch IsChecked="{Binding Config.EnableDebugLog}" Margin="0,0,20,0" Content="输出调试"/>
                        <ui:Button Content="打开画面" Command="{Binding OpenDebugWindowCommand}" Appearance="Secondary" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ui:TextBlock Text="字号:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider Value="{Binding Config.DebugFontScale}" Minimum="0.3" Maximum="1.5" Width="120" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </controls:SettingItem>

            <!-- 圆心拖拽区域 -->
            <local:AutoMusicRoiView DataContext="{Binding RoiVm}" />

            <!-- 一键恢复默认参数 -->
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16,10">
                <ui:Button Command="{Binding ResetSettingsCommand}" 
                           Content="恢复默认参数" 
                           Icon="{ui:SymbolIcon ArrowReset24}" 
                           Appearance="Danger" 
                           HorizontalAlignment="Right" 
                           ToolTip="将判定参数和圆心坐标恢复为初始状态" />
            </Grid>

        </StackPanel>
    </ui:CardExpander>
</UserControl>