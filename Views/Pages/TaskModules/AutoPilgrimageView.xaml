<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoPilgrimageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '异象巡礼'}" 
                                     Description="{helpers:Trans '周本挑战'}" 
                                     IconImage="Assets/pilgrimage_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{helpers:Trans '启动'}" Command="{Binding StartCommand}" Width="72"  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="{helpers:Trans '停止'}" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="挑战模式" Description="联机或单人">
                <ComboBox Width="150" SelectedItem="{Binding Config.ChallengeMode}">
                    <ComboBoxItem Content="联机模式" />
                    <ComboBoxItem Content="单人模式" />
                </ComboBox>
            </controls:SettingItem>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="挑战策略选择" Description="选择几个目标">
                <ComboBox Width="150" SelectedItem="{Binding Config.Strategy}">
                    <ComboBoxItem Content="挑战1个目标" />
                    <ComboBoxItem Content="挑战2个目标" />
                    <ComboBoxItem Content="挑战3个目标" />
                </ComboBox>
            </controls:SettingItem>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="挑战目标输入" Description="目标1打1次输入11，回车键换行">
                <ui:TextBox Width="200" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Config.TargetsInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如：&#x0a;11&#x0a;21"/>
            </controls:SettingItem>
        </StackPanel>
    </ui:CardExpander>
</UserControl>