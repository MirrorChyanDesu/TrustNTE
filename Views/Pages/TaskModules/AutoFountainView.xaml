<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoFountainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '喷泉签到'}" 
                                     Description="{helpers:Trans '虔诚许愿与硬币捞捞'}" 
                                     IconImage="Assets/fountain_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{helpers:Trans '启动'}" Command="{Binding StartCommand}" Width="72"  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="{helpers:Trans '停止'}" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="签到模式" Description="选择打卡方式">
                <ComboBox Width="150" SelectedItem="{Binding Config.SignMode}">
                    <ComboBoxItem Content="虔诚许愿" />
                    <ComboBoxItem Content="硬币捞捞" />
                </ComboBox>
            </controls:SettingItem>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="自动传送" Description="不在喷泉附近时自动前往">
                <ui:ToggleSwitch IsChecked="{Binding Config.AutoTeleport}" />
            </controls:SettingItem>
        </StackPanel>
    </ui:CardExpander>
</UserControl>