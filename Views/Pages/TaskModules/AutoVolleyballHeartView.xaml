<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoVolleyballHeartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '排球之心'}" 
                                     Description="{helpers:Trans '自动挑战排球之心'}" 
                                     IconImage="Assets/volleyball_heart_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{helpers:Trans '启动'}" Command="{Binding StartCommand}" Width="72"  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="{helpers:Trans '停止'}" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="自动传送" Description="不在排球之心附近时传送">
                <ComboBox Width="150" SelectedIndex="{Binding Config.TeleportTarget}">
                    <ComboBoxItem Content="1 不传送" />
                    <ComboBoxItem Content="2 碧波排球场" />
                    <ComboBoxItem Content="3 理想馆排球场" />
                </ComboBox>
            </controls:SettingItem>
        </StackPanel>
    </ui:CardExpander>
</UserControl>