<UserControl x:Class="TrustNTE.Views.Pages.TaskModules.AutoGiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="False">
        <ui:CardExpander.Header>
            <controls:TaskCardHeader Title="{helpers:Trans '羁绊礼物'}" 
                                     Description="{helpers:Trans '自动赠送礼物提升羁绊'}" 
                                     IconImage="Assets/gift_icon.png">
                <controls:TaskCardHeader.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{helpers:Trans '启动'}" Command="{Binding StartCommand}" Width="72"  Visibility="{Binding IsRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        <ui:Button Content="{helpers:Trans '停止'}" Command="{Binding StopCommand}" Appearance="Danger" Width="72" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:TaskCardHeader.HeaderContent>
            </controls:TaskCardHeader>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <controls:SettingItem Title="配置赠礼名单" Description="配置赠送角色及次数(1-3)与礼物类型(1-6)">
                <ui:TextBlock Text="请在下方配置" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </controls:SettingItem>

            <Border Margin="16" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <!-- 排序控制栏 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:TextBlock Text="角色列表排序：" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <ui:Button Content="按拼音正序" Command="{Binding SortCharactersAscendingCommand}" Margin="0,0,10,0" Appearance="Secondary"/>
                        <ui:Button Content="按拼音倒序" Command="{Binding SortCharactersDescendingCommand}" Appearance="Secondary"/>
                    </StackPanel>

                    <!-- 列表头 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="角色名称" FontWeight="Bold" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock Grid.Column="1" Text="礼物选择" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock Grid.Column="2" Text="赠送次数" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- 7 个赠礼槽位 -->
                    <!-- [模块H]    改原因：使用 ItemsControl 循环渲染 7 个槽位，并开启 ComboBox 的前缀搜索 -->
                    <ItemsControl ItemsSource="{Binding Config.Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- [模块H]    改原因：绑定 AvailableCharacters，开启 IsTextSearchEnabled 实现原生首字母匹配搜索 -->
                                    <ComboBox Grid.Column="0" 
                                              ItemsSource="{Binding DataContext.AvailableCharacters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding CharacterName}"
                                              IsTextSearchEnabled="True"
                                              HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                    <!-- [模块H]    改原因：绑定 AvailableGifts 集合（1-6） -->
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.AvailableGifts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding GiftType}"
                                              HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                    <!-- [模块H]    改原因：绑定 AvailableGiftCounts 集合（1-3） -->
                                    <ComboBox Grid.Column="2" 
                                              ItemsSource="{Binding DataContext.AvailableGiftCounts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding GiftCount}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:CardExpander>
</UserControl>