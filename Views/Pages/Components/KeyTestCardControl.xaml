<UserControl x:Class="TrustNTE.Views.Pages.Components.KeyTestCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Keyboard24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="按键与点击测试" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="测试游戏UI对应坐标与底层输入" />
                </StackPanel>
            </Grid>
        </ui:CardExpander.Header>
        
        <StackPanel Margin="16,8">
            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                <ui:TextBlock Text="按键测试:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0" />
                <ui:Button Content="W" Command="{Binding TestSendWCommand}" Margin="0,0,10,0" MinWidth="40" />
                <ui:Button Content="S" Command="{Binding TestSendSCommand}" Margin="0,0,10,0" MinWidth="40" />
                <ui:Button Content="A" Command="{Binding TestSendACommand}" Margin="0,0,10,0" MinWidth="40" />
                <ui:Button Content="D" Command="{Binding TestSendDCommand}" Margin="0,0,10,0" MinWidth="40" />
                <ui:Button Content="F" Command="{Binding TestSendFCommand}" Margin="0,0,10,0" MinWidth="40" />
                <ui:Button Content="空格" Command="{Binding TestSendSpaceCommand}" MinWidth="50" />
            </WrapPanel>

            <Separator Margin="0,0,0,10" BorderThickness="0,1,0,0" />

            <WrapPanel Margin="0,0,0,15" VerticalAlignment="Center">
                <ui:TextBlock Text="点击测试:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0" />
                <ui:Button Content="后台点击" Command="{Binding TestBackgroundClickCommand}" Margin="0,0,10,0" />
                <ui:Button Content="物理点击" Command="{Binding TestPhysicalClickCommand}" Margin="0,0,10,0" />
                <ui:Button Content="通用点击" Command="{Binding TestTrickClickCommand}" Margin="0,0,20,0" />

                <ui:TextBlock Text="点击坐标:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ui:NumberBox Value="{Binding TestClickX}" MinWidth="80" Margin="0,0,5,0" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                <ui:NumberBox Value="{Binding TestClickY}" MinWidth="80" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
            </WrapPanel>

            <Separator Margin="0,0,0,10" BorderThickness="0,1,0,0" />

            <ui:TextBlock TextWrapping="Wrap" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="UI对应坐标提醒:" FontWeight="Bold" />
                <Run Text="【关掉背包】 1831, 63  " />
                <Run Text="【一咖舍】 632, 663  " />
                <Run Text="【提取收益】 362, 933" />
            </ui:TextBlock>
        </StackPanel>
    </ui:CardExpander>
</UserControl>