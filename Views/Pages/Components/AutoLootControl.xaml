<UserControl x:Class="TrustNTE.Views.Pages.Components.AutoLootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon HandLeft24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '自动拾取'}" />
                    <TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{helpers:Trans '选项不是 NPC 对话且符合名单时，自动按下'}" /><Run Text="{Binding Config.AutoLootKey, Mode=OneWay}" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold"/><Run Text="{helpers:Trans ' 拾取/交互'}" />
                    </TextBlock>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,24,0" IsChecked="{Binding Config.AutoLootEnabled}" VerticalAlignment="Center" />
            </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="选择自动拾取文字识别引擎" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="Paddle可识别所有文字,速度慢,消耗少; Yap可识别部分文字,快且准" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="150" Margin="0,0,36,0" SelectedItem="{Binding Config.AutoLootEngine}">
                    <ComboBoxItem Content="Paddle" />
                    <ComboBoxItem Content="Yap" />
                </ComboBox>
            </Grid>

            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="自定义拾取按键" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="默认为 F，需更改成其他键的请阅读文档" />
                </StackPanel>
                <ui:TextBox Grid.Column="1" Width="100" Margin="0,0,36,0" Text="{Binding Config.AutoLootKey, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="黑白名单模式" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="统一配置，避免黑白名单同时开启导致逻辑冲突" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="130" Margin="0,0,16,0" ItemsSource="{Binding ListModes}" SelectedItem="{Binding Config.AutoLootListMode}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="2" Content="配置名单" Margin="0,0,36,0" Command="{Binding OpenListConfigCommand}" />
            </Grid>

            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="{helpers:Trans '粉爪银行拾取'}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="识别到物品按几次 F" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:NumberBox Value="{Binding Config.PinkPawFPressCount}" Minimum="1" Maximum="10" MaxDecimalPlaces="0" Width="90" SpinButtonPlacementMode="Compact" Margin="0,0,24,0" />
                    <TextBlock Text="间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:NumberBox Value="{Binding Config.PinkPawFPressIntervalMs}" Minimum="100" Maximum="2000" MaxDecimalPlaces="0" Width="110" SpinButtonPlacementMode="Compact" Margin="0,0,24,0" />
                    <ui:ToggleSwitch IsChecked="{Binding Config.PinkPawPickupEnabled}" VerticalAlignment="Center" ToolTip="开启/关闭粉爪拾取" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ui:CardExpander>
</UserControl>