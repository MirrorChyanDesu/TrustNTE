<UserControl x:Class="TrustNTE.Views.Pages.Components.CarouselCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">

    <Grid Height="200" Margin="0,0,0,12">

        <!-- 底层图片与圆角遮罩 -->
        <Border CornerRadius="8">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Rectangle RadiusX="8" RadiusY="8" Fill="White" 
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}" 
                                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>

            <!-- 【核心   改】改用 Image 控件，并绑定附加属性开启淡入动画 -->
            <!-- 注意：NotifyOnTargetUpdated="True" 是触发动画的关键 -->
            <Image Source="{Binding CurrentCarouselImage, NotifyOnTargetUpdated=True}" 
                   RenderOptions.BitmapScalingMode="HighQuality" 
                   Stretch="UniformToFill"
                   helpers:ImageFadeBehavior.EnableFade="True" />
        </Border>

        <!-- 渐变遮罩层 -->
        <Rectangle RadiusX="8" RadiusY="8" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#CC000000" Offset="0.0" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 文字信息 -->
        <StackPanel Margin="52,0,0,26" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <ui:TextBlock FontTypography="Title" Text="TrustNTE" Foreground="White" />
            <ui:TextBlock FontTypography="Subtitle" Opacity="0.9" Text="{helpers:Trans 'TrustNTE · 解放双手！开源免费！为爱发电！'}" Foreground="White" />
        </StackPanel>

        <!-- 轮播图圆点指示器 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,15">
            <Grid Margin="4,0" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DotClickCommand}" CommandParameter="0" />
                </Grid.InputBindings>
                <Ellipse Width="8" Height="8" Fill="White" Opacity="{Binding Dot0Opacity}" />
            </Grid>
            <Grid Margin="4,0" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DotClickCommand}" CommandParameter="1" />
                </Grid.InputBindings>
                <Ellipse Width="8" Height="8" Fill="White" Opacity="{Binding Dot1Opacity}" />
            </Grid>
            <Grid Margin="4,0" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DotClickCommand}" CommandParameter="2" />
                </Grid.InputBindings>
                <Ellipse Width="8" Height="8" Fill="White" Opacity="{Binding Dot2Opacity}" />
            </Grid>
            <Grid Margin="4,0" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DotClickCommand}" CommandParameter="3" />
                </Grid.InputBindings>
                <Ellipse Width="8" Height="8" Fill="White" Opacity="{Binding Dot3Opacity}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>