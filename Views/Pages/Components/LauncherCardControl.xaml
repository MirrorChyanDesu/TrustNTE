<UserControl x:Class="TrustNTE.Views.Pages.Components.LauncherCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">

    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon LinkSquare24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '同时启动异环启动器'}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '启动截图器时，如果异环未运行，则自动启动'}" />
                </StackPanel>
                <!-- 补全了开关的双向绑定 -->
                <ui:ToggleSwitch Grid.Column="1" Margin="0,0,24,0" IsChecked="{Binding StartGameTogether, Mode=TwoWay}" VerticalAlignment="Center" />
            </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 补全了路径输入框的双向绑定 -->
                <ui:TextBox Grid.Column="0" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" PlaceholderText="{helpers:Trans '请点击右侧浏览按钮选择启动器，或直接粘贴路径...'}"/>
                <!-- 补全了浏览按钮的命令绑定 -->
                <ui:Button Grid.Column="1" Content="{helpers:Trans '浏览'}" Margin="0,0,36,0" Command="{Binding BrowseGamePathCommand}" />
            </Grid>
        </StackPanel>
    </ui:CardExpander>
</UserControl>