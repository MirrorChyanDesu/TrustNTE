<UserControl x:Class="TrustNTE.Views.Pages.Components.MonthlyCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Money24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '自动领取月卡/环石'}" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '开启后无视任务屏蔽直接领取（防小白找客服）'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent" Margin="0,0,16,0" Command="{Binding ShowMonthlyCardDocCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,4,0" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="文档" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:ToggleSwitch Margin="0,0,24,0" IsChecked="{Binding Config.MonthlyCardEnabled}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="触发时间模式" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="全天启用会持续扫描；指定时间仅在特定窗口唤醒线程" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,36,0" VerticalAlignment="Center">
                    <RadioButton Content="全天启用" IsChecked="{Binding Config.MonthlyCardAllDay}" Margin="0,0,16,0" />
                    <RadioButton Content="指定时间段" IsChecked="{Binding IsMonthlyCardCustomTime}" />
                </StackPanel>
            </Grid>

            <Border Visibility="{Binding IsTimeSettingVisible}" Padding="16,12" Margin="0,0,0,12" Background="{ui:ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Body" Text="时间:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ui:TextBox Width="70" Text="{Binding Config.MonthlyCardStartTime, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" PlaceholderText="03:50"/>
                        <TextBlock Text="~" Margin="12,0" VerticalAlignment="Center"/>
                        <ui:TextBox Width="70" Text="{Binding Config.MonthlyCardEndTime, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" PlaceholderText="04:10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,36,0">
                        <ui:TextBlock FontTypography="Body" Text="时区对齐:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <!--        纯整数绑定，无需转换器 -->
                        <ComboBox Width="200" SelectedIndex="{Binding MonthlyCardTimeZoneIndex, Mode=TwoWay}" VerticalAlignment="Center">
                            <ComboBoxItem Content="跟随本地电脑时间 (推荐国际服)"/>
                            <ComboBoxItem Content="固定北京时间 UTC+8 (国服)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ui:CardExpander>
</UserControl>