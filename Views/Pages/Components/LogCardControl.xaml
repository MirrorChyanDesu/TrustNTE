<UserControl x:Class="TrustNTE.Views.Pages.Components.LogCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers">
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon DocumentText24}" IsExpanded="False">
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '日志设置'}" />
                    <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '控制日志窗口与游戏内悬浮遮罩'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding LogWindowBtnText}" Command="{Binding OpenLogWindowCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="{Binding MaskBtnText}" Command="{Binding ToggleMaskCommand}" Margin="0,0,24,0" />
                </StackPanel>
            </Grid>
        </ui:CardExpander.Header>

        <StackPanel Margin="16">
            <!-- 透明度控制 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="{helpers:Trans '遮罩背景透明度:'}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0.0" Maximum="1.0" IsSnapToTickEnabled="False" Value="{Binding MaskOpacity}" VerticalAlignment="Center" />
                <ui:TextBlock Grid.Column="2" FontTypography="Body" Text="{Binding MaskOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="{helpers:Trans '遮罩文字透明度:'}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0.1" Maximum="1.0" IsSnapToTickEnabled="False" Value="{Binding MaskTextOpacity}" VerticalAlignment="Center" />
                <ui:TextBlock Grid.Column="2" FontTypography="Body" Text="{Binding MaskTextOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <Separator Margin="-16,5,-16,10" BorderThickness="0,1,0,0" />

            <!-- 遮罩显示区域选择 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="{helpers:Trans '遮罩显示位置:'}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="150" SelectedIndex="{Binding MaskPositionIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="左下角" />
                    <ComboBoxItem Content="右下角" />
                </ComboBox>
            </Grid>

            <Separator Margin="-16,5,-16,10" BorderThickness="0,1,0,0" />

            <!-- 自定义颜色区 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '日志颜色自定义'}" FontWeight="Bold" VerticalAlignment="Center"/>
                <!--     恢复默认颜色按钮 -->
                <ui:Button Grid.Column="1" Content="恢复默认颜色" Command="{Binding ResetLogColorsCommand}" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Secondary" Padding="8,4"/>
            </Grid>

            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="默认文本:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorDefault}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorDefault" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="鼠标点击:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorMouse}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorMouse" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="键盘按键:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorKeyboard}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorKeyboard" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="守护监管:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorGuard}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorGuard" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="高频日志:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorHighFreq}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorHighFreq" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <ui:TextBlock Text="错误异常:" VerticalAlignment="Center" Width="70"/>
                    <TextBox Text="{Binding Config.LogColorError}" IsReadOnly="True" Width="80" Margin="0,0,5,0"/>
                    <ui:Button Content="选色" Command="{Binding PickColorCommand}" CommandParameter="LogColorError" Icon="{ui:SymbolIcon Color24}" Padding="8,4"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
    </ui:CardExpander>
</UserControl>