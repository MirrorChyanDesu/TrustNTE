<UserControl x:Class="TrustNTE.Views.Pages.TaskSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:modules="clr-namespace:TrustNTE.Views.Pages.TaskModules"
             xmlns:vmModules="clr-namespace:TrustNTE.ViewModels.Pages.TaskModules"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <!-- 利用 DataTemplate 自动匹配对应的 View -->
        <DataTemplate DataType="{x:Type vmModules:AutoFishingViewModel}">
            <modules:AutoFishingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoMusicViewModel}">
            <modules:AutoMusicView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoPawViewModel}">
            <modules:AutoPawView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoApartmentViewModel}">
            <modules:AutoApartmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoFountainViewModel}">
            <modules:AutoFountainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoMarketViewModel}">
            <modules:AutoMarketView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoGiftViewModel}">
            <modules:AutoGiftView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoVolleyballHeartViewModel}">
            <modules:AutoVolleyballHeartView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoRedeemViewModel}">
            <modules:AutoRedeemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoHuntViewModel}">
            <modules:AutoHuntView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmModules:AutoPilgrimageViewModel}">
            <modules:AutoPilgrimageView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="42,16,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" FontTypography="Subtitle" Text="{helpers:Trans '独立任务大模块设置'}" Margin="0,0,0,12"/>

        <!-- 使用 ListBox 开启 VirtualizingStackPanel 虚拟化，彻底解决首屏卡顿 -->
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding Modules}" 
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,42,0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>