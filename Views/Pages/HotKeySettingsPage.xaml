<UserControl x:Class="TrustNTE.Views.Pages.HotKeySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             xmlns:controls="clr-namespace:TrustNTE.Views.Controls"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid Margin="42,16,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0" Margin="0,0,0,8" FontTypography="BodyStrong" Text="快捷键设置" />
        <ui:TextBlock Grid.Row="1" Margin="0,0,0,12"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      Text="全局热键：只支持组合键和功能键，软件启动直接生效。键鼠监听：支持任意键盘单键、鼠标侧键，功能启动后才生效（推荐）。点击类型按钮可以切换快捷键类型。其中存在长按需求的功能不能使用全局热键。"
                      TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,42,0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Text="功能" FontTypography="BodyStrong" />
                    <ui:TextBlock Grid.Column="1" Text="快捷键类型" FontTypography="BodyStrong" HorizontalAlignment="Center" />
                    <ui:TextBlock Grid.Column="2" Text="配置快捷键" FontTypography="BodyStrong" HorizontalAlignment="Center" />
                </Grid>
                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{ui:ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0"/>

                <!-- 树形列表 -->
                <TreeView Grid.Row="1" 
                          ItemsSource="{Binding HotKeys}" 
                          Background="Transparent" 
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,10">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 原生展开按钮 -->
                                                    <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press" 
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

                                                    <!-- 内容全宽拉伸 -->
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- 子节点靠左 -->
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="false">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="false">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：功能名称及缩进控制 -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <!-- 默认无缩进（针对父级目录） -->
                                            <Setter Property="Margin" Value="0"/>
                                            <Style.Triggers>
                                                <!-- 如果是子节点，往右缩进 16px -->
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                    <Setter Property="Margin" Value="24,0,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <ui:TextBlock FontTypography="Body" Text="{Binding FunctionName}">
                                        <ui:TextBlock.Style>
                                            <Style TargetType="ui:TextBlock">
                                                <!-- 子节点字体正常 -->
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <!-- 父级目录加粗并变色 -->
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>

                                <!-- 中间：类型按钮 -->
                                <ui:Button Grid.Column="1" 
                                           Height="32" Margin="10,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                                           Command="{Binding DataContext.SwitchTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Content" Value="{Binding HotKeyTypeName}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotKeyType}" Value="None">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <!-- 右侧：录入框 -->
                                <controls:HotKeyTextBox Grid.Column="2" 
                                                        Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120"
                                                        Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                                                        HotKey="{Binding HotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>