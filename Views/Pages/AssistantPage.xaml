<UserControl x:Class="TrustNTE.Views.Pages.AssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid Margin="42,16,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,42,0">
                
                <ui:TextBlock FontTypography="Subtitle" Text="辅助操控设置" Margin="0,0,0,12"/>

                <!-- 数据驱动渲染 5 个卡片 -->
                <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Cursor24}" IsExpanded="False">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock FontTypography="Body" Text="{Binding Title}" />
                                            <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Description}" />
                                        </StackPanel>

                                        <!-- 右侧控制区 -->
                                        <Grid Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <!-- 真实功能显示开关 -->
                                            <ui:ToggleSwitch 
                                                IsChecked="{Binding IsEnabled, Mode=TwoWay, TargetNullValue=False, FallbackValue=False}"
                                                Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />
                                            
                                            <!-- 占位功能显示按钮 -->
                                            <ui:Button Content="绑定快捷键" Appearance="Secondary"
                                                       Command="{Binding DataContext.BindHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </ui:CardExpander.Header>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>