<UserControl x:Class="TrustNTE.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid Margin="42,16,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,42,0">

                <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Globe24}" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '语言设置'}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '软件界面语言'}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '切换软件界面的显示语言（重启生效）'}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="0,0,36,0"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Config.UiLanguage, Mode=TwoWay}" />
                        </Grid>

                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '游戏内语言'}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '用于识别游戏内文字（如剧情、菜单）'}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="0,0,36,0"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Config.GameLanguage, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Color24}" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '应用主题'}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '软件主题外观'}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '切换软件的明暗外观'}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Margin="0,0,36,0"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding Config.AppTheme, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon ArrowDownload24}" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '版本更新'}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '检查软件是否有新版本可用'}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="{helpers:Trans '检查更新'}" Margin="0,0,36,0" Command="{Binding CheckUpdateCommand}" />
                        </Grid>

                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '检查是否存在最新测试版'}" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Trans '【测试版】非常不稳定，请谨慎选择更新！'}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="{helpers:Trans '检查更新'}" Margin="0,0,36,0" Command="{Binding CheckBetaUpdateCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 其他设置部分 -->
                <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Options24}" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '其他设置'}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                        <!-- 开机自启动 -->
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="开机自启动 (登录静默)" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="开启后，Windows 登录时软件将在右下角托盘静默运行，不弹主界面。" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                        <!-- 自启后自动挂机 -->
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="自启后自动挂机" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                                              Text="开启后，开机自启时将自动绑定游戏并开启截图引擎。否则仅在托盘静默待命。" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.AutoStartEngineOnLogin, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />

                        <!-- 停止截图后继续守护 -->
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="停止截图后继续守护" />
                                <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                                              Text="引擎停止后，是否仍自动处理掉线重连/闪退重启。关闭则完全收工。未开启过截图前，此功能不生效。" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Margin="0,0,36,0" IsChecked="{Binding Config.IdleGuardEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon Info24}" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <ui:TextBlock FontTypography="Body" Text="{helpers:Trans '关于 TrustNTE'}" />
                    </ui:CardExpander.Header>
                    <StackPanel Margin="16">
                        <ui:Button Content="{helpers:Trans '查看项目信息'}" Command="{Binding ShowAboutCommand}" />
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>