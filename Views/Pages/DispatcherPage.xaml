<UserControl x:Class="TrustNTE.Views.Pages.DispatcherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,16,16,10">
                <ui:TextBlock Text="配置分组" FontTypography="Subtitle" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowImport24}" ToolTip="导入分组"
                               Command="{Binding ImportGroupCommand}" Margin="0,0,5,0"/>
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowExport24}" ToolTip="导出当前选中分组"
                               Command="{Binding ExportGroupCommand}" CommandParameter="{Binding SelectedGroup}" Margin="0,0,5,0"/>
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Add24}" ToolTip="新增组"
                               Command="{Binding AddGroupCommand}"/>
                </StackPanel>
            </Grid>

            <!-- [模块G]    改原因：用 BindingProxy 将 ListBox 的 DataContext（即 DispatcherPageViewModel）
                 暴露给弹出层 ContextMenu，取代原 ListBoxItem.Tag 塞 DataContext 的 Hack 写法，
                 使 ListBoxItem.Tag 恢复空闲，未来可用于拖拽/搜索等场景 -->
            <ListBox Grid.Row="1" Margin="8,0,8,0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top">

                <ListBox.Resources>
                    <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
                </ListBox.Resources>

                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding SelectedGroup}"/>
                </ListBox.InputBindings>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <!-- [模块G]    改原因：删除 Tag 赋值，ContextMenu 改用 StaticResource 引用 ViewModelProxy -->
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <!-- [模块G]    改原因：Command 改为通过 ViewModelProxy 绑定；CommandParameter 通过 PlacementTarget.DataContext 拿当前右键的 ScriptGroup -->
                                    <MenuItem Header="新增组" Command="{Binding Data.AddGroupCommand, Source={StaticResource ViewModelProxy}}"/>
                                    <MenuItem Header="删除组" Command="{Binding Data.DeleteGroupCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="重命名" Command="{Binding Data.RenameGroupCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="复制组" Command="{Binding Data.CopyGroupCommand, Source={StaticResource ViewModelProxy}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <ui:TextBlock Text="{Binding Name}" FontTypography="Body" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="禁用" HorizontalAlignment="Right" 
                                          Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToInverseVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="16,10,16,16">
                <ui:Button Content="连续执行所有组" Width="72" Margin="0,0,0,8" 
                           Command="{Binding RunContinuousCommand}" HorizontalAlignment="Stretch"/>
                <ui:Button Content="执行选中分组" 
                           Command="{Binding RunByGroupCommand}" CommandParameter="{Binding SelectedGroup}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="16">
            <Border Visibility="{Binding HasSelectedGroup, Converter={StaticResource BooleanToInverseVisibilityConverter}}"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" 
                    CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                    <ui:SymbolIcon Symbol="Info24" FontSize="48" HorizontalAlignment="Center" 
                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                    <ui:TextBlock Text="请从左侧选择一个配置组" FontTypography="Subtitle" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,12" Padding="16" 
                        CornerRadius="8" BorderThickness="1" 
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding SelectedGroup.Name}" FontTypography="Subtitle" />
                            <ui:TextBlock Text="按顺序执行下方启用的任务" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="运行" Icon="{ui:SymbolIcon Play24}" Width="72" Margin="0,0,8,0"
                                       Command="{Binding RunGroupCommand}" CommandParameter="{Binding SelectedGroup}"/>
                            <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" 
                                       Command="{Binding AddProjectCommand}" CommandParameter="{Binding SelectedGroup}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="10" 
                        CornerRadius="8" BorderThickness="1" 
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <TextBlock Text="暂无任务，请点击上方“添加”按钮创建"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Projects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListView ItemsSource="{Binding SelectedGroup.Projects}" 
                                  SelectedItem="{Binding SelectedProject}"
                                  Background="Transparent" BorderThickness="0" 
                                  VerticalContentAlignment="Top"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListView.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteProjectCommand}" CommandParameter="{Binding SelectedProject}"/>
                            </ListView.InputBindings>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}" 
                                            CornerRadius="4" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <ComboBox Grid.Column="1" SelectedItem="{Binding Type}" Margin="0,0,10,0" HorizontalContentAlignment="Center">
                                                <ComboBoxItem Content="Javascript" />
                                                <ComboBoxItem Content="KeyMouse" />
                                                <ComboBoxItem Content="Shell" />
                                            </ComboBox>

                                            <ui:TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>

                                            <ui:TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>