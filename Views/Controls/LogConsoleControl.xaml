<UserControl x:Class="TrustNTE.Views.Controls.LogConsoleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Ellipse Width="8" Height="8" Fill="#00FFCC" Margin="0,0,6,0" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#00FFCC" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="TitleText" Text="运行日志" Foreground="#A0FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogText" FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
        </ScrollViewer>
    </Grid>
</UserControl>