<UserControl x:Class="TrustNTE.Views.Controls.TaskCardHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TrustNTE.Helpers"
             x:Name="Root">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">

            <ui:SymbolIcon Symbol="{Binding Icon, ElementName=Root}" FontSize="20" 
                           Visibility="{Binding IconImage, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}" />

            <Image Source="{Binding IconImage, ElementName=Root}" Stretch="Uniform"
                   Visibility="{Binding IconImage, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="Body" Text="{Binding Title, ElementName=Root}" />
            <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Description, ElementName=Root}" />
        </StackPanel>

        <ContentPresenter Grid.Column="2" Content="{Binding HeaderContent, ElementName=Root}" 
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Right" 
                  Margin="0,0,16,0"/>
    </Grid>
</UserControl>