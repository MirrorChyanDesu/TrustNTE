<UserControl x:Class="TrustNTE.Views.Controls.SettingItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="Body" Text="{Binding Title, ElementName=Root}" />
            <ui:TextBlock FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Description, ElementName=Root}" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding Content, ElementName=Root}" VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>
</UserControl>