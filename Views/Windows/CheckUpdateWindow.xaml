<ui:FluentWindow x:Class="TrustNTE.Views.Windows.CheckUpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="发现新版本" Height="560" Width="550"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Margin="24,10,24,10" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ui:TextBlock Text="{Binding ReleaseNote}" TextWrapping="Wrap" FontTypography="Body" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="24,0,24,16">
            <!-- 1. GitHub 更新 -->
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Views/Windows/Assets/icon_github.png" Width="32" Height="32" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="从 Github 更新" FontTypography="Body" />
                        <ui:TextBlock Text="开源渠道，国内下载可能较慢" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <!-- 把宽度加大到 90，解决文字截断问题 -->
                <ui:Button Content="立即更新" MinWidth="90" Command="{Binding UpdateFromGithubCommand}" />
            </ui:CardControl>

            <!-- 2. 网盘更新 -->
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Views/Windows/Assets/icon_baidu.png" Width="32" Height="32" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="网盘加速下载" FontTypography="Body" />
                        <ui:TextBlock Text="国内高速下载，任选其一" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <!-- 三个网盘按钮 -->
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="蓝奏云" Appearance="Success" Command="{Binding OpenLanZouCommand}" Margin="0,0,6,0" />
                    <ui:Button Content="夸克" Appearance="Primary" Command="{Binding OpenQuarkCommand}" Margin="0,0,6,0" />
                    <ui:Button Content="百度" Appearance="Secondary" Command="{Binding OpenBaiduCommand}" />
                </StackPanel>
            </ui:CardControl>

            <!-- 3. QQ 群更新 -->
            <ui:CardControl>
                <ui:CardControl.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Views/Windows/Assets/icon_qq.png" Width="32" Height="32" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="QQ群更新" FontTypography="Body" />
                        <ui:TextBlock Text="加入官方群，在群文件下载最新版" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="加入QQ群" Appearance="Secondary" Command="{Binding JoinQQGroupCommand}" />
            </ui:CardControl>
        </StackPanel>

        <Grid Grid.Row="3" Margin="24,0,24,24">
            <ui:Button Content="跳过此版本" Appearance="Secondary" HorizontalAlignment="Left" Command="{Binding SkipVersionCommand}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="不再提示" Margin="0,0,10,0" Command="{Binding IgnoreVersionCommand}" />
                <ui:Button Content="取消" Appearance="Secondary" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>