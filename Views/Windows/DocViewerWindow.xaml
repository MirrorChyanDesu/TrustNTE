<ui:FluentWindow x:Class="TrustNTE.Views.Windows.DocViewerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="说明文档" Width="720" Height="750"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🚨 核心修复：直接用字符串绑定窗口的 Title -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 核心：WebView2 控件 (去掉了不能用的 Background) -->
        <Border Grid.Row="1" Margin="16,8,16,8" 
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <wv2:WebView2 x:Name="MarkdownWebView" />
        </Border>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Padding="24,16" 
                Background="{ui:ThemeResource ControlFillColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
            <ui:Button Content="朕已阅" Appearance="Primary" Width="120" HorizontalAlignment="Right" Click="OnCloseClick"/>
        </Border>
    </Grid>
</ui:FluentWindow>