<ui:FluentWindow x:Class="TrustNTE.Views.Windows.CombatDebugWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="YOLO 战斗视角" Height="540" Width="960"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica" 
                 ExtendsContentIntoTitleBar="True" 
                 Background="#1A1A1A"
                 Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="YOLO 战斗视角" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="#1A1A1A">
            <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                <ui:TextBlock Text="等待战斗画面数据..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                    <ui:TextBlock.Style>
                        <Style TargetType="ui:TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:TextBlock.Style>
                </ui:TextBlock>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>