<ui:FluentWindow x:Class="TrustNTE.Views.Windows.AutoMusicDebugWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="音游调试" Height="850" Width="1280"
                 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Topmost="True">
    <Grid>
        <Border Background="#111" x:Name="PreviewBorder">
            <Image x:Name="Preview" Source="{Binding PreviewImage}" Stretch="Uniform" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseWheel="Preview_MouseWheel" 
                   MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                   MouseMove="Preview_MouseMove"
                   MouseLeftButtonUp="Preview_MouseLeftButtonUp"/>
        </Border>

        <!--     悬浮提示文字（左下角，不影响视线） -->
        <Border Background="#A0000000" CornerRadius="6" Padding="12,8" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Foreground="DeepSkyBlue" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="按住画面上的【绿圈】拖动，可实时改 D F J K 的判定圆心" 
                           Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 隐藏的系统样式 TitleBar -->
        <ui:TitleBar x:Name="TitleBar" VerticalAlignment="Top" Background="Transparent" ShowMinimize="True" ShowClose="True"/>
    </Grid>
</ui:FluentWindow>