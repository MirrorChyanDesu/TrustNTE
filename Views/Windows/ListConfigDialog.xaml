<ui:FluentWindow x:Class="TrustNTE.Views.Windows.ListConfigDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="黑白名单配置" Height="550" Width="650"
                 MinHeight="400" MinWidth="350"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="黑白名单配置" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- [模块A]    改原因：按钮 Appearance 由 VM 的 IsWhiteMode 通过 DataTrigger 控制，
             原代码在 XAML.cs 里直接赋值 BtnWhite.Appearance / BtnBlack.Appearance 的方式已废弃 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,10,24,10">
            <ui:Button Content="白名单" Width="80" Margin="0,0,10,0" Command="{Binding SwitchToWhiteCommand}">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Secondary"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWhiteMode}" Value="True">
                                <Setter Property="Appearance" Value="Primary"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
            <ui:Button Content="黑名单" Width="80" Command="{Binding SwitchToBlackCommand}">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Secondary"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWhiteMode}" Value="False">
                                <Setter Property="Appearance" Value="Primary"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- [模块A]    改原因：原 x:Name="PromptText" 由代码直接赋值，改为绑定 -->
            <ui:TextBlock Grid.Row="0" Text="{Binding PromptText}" FontTypography="Body" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- [模块A]    改原因：原 x:Name="InputBox" 由代码直接读写，改为双向绑定 -->
            <ui:TextBox Grid.Row="1"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        VerticalAlignment="Stretch"
                        PlaceholderText="每行一条记录。回车键换行。点击右下角×会清空全部内容，删除单行请用退格键。"/>
        </Grid>

        <Grid Grid.Row="3" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:TextBlock Text="保存后立即生效" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>

               
                <ui:HyperlinkButton Content="文档"
                                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                                    Command="{Binding ShowHelpCommand}"
                                    ToolTip="点击查看操作说明"/>
            </StackPanel>

   
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="保存" Width="80"  Margin="0,0,12,0" Command="{Binding ConfirmCommand}"/>
                <ui:Button Content="取消" Appearance="Secondary" Width="80" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>