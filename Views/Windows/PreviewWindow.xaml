<ui:FluentWindow x:Class="TrustNTE.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:TrustNTE.Helpers"
        Title="{helpers:Trans '异环 - 实时预览'}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" 
        ExtendsContentIntoTitleBar="True" 
        Background="#1A1A1A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{helpers:Trans '异环 - 实时预览'}" Background="Transparent">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="#1A1A1A">
            <Grid>
                <Image Source="{Binding ScreenSource}" Stretch="Uniform"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding PreviewPlaceholderVisibility}">
                    <ui:SymbolIcon Symbol="Camera24" FontSize="64" 
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <ui:TextBlock Text="{helpers:Trans '等待启动截图引擎'}" FontTypography="Subtitle" 
                                  Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" 
                                  HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <ui:TextBlock Text="{helpers:Trans '请前往【启动】页面，点击【启动】按钮以连接游戏画面'}" 
                                  FontTypography="Body" 
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" 
                                  HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 左下角：预览模式切换 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                        Margin="16,0,0,16" Padding="10,5" 
                        CornerRadius="4" Background="#AA000000">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="{helpers:Trans '无延迟画面'}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:ToggleSwitch IsChecked="{Binding IsZeroDelayMode, Mode=TwoWay}" 
                                         ToolTip="开启：只处理最新一帧，丢帧保证低延迟。关闭：排队处理每一帧，但会严重延迟。"/>
                    </StackPanel>
                </Border>

                <!-- 右下角：FPS -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                        Margin="0,0,16,16" Padding="10,5" 
                        CornerRadius="4" Background="#AA000000">
                    <ui:TextBlock Text="{Binding FpsText}" 
                                  FontFamily="Consolas, Microsoft YaHei"
                                  FontWeight="Bold" Foreground="#4ADE80" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>