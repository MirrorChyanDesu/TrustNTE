<ui:FluentWindow x:Class="TrustNTE.Views.RedeemCodeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:helpers="clr-namespace:TrustNTE.Helpers"
                 Title="{helpers:Trans '异环最新兑换码'}" Height="650" Width="460"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{helpers:Trans '异环最新兑换码'}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 切换按钮 -->
                <RowDefinition Height="Auto"/>
                <!-- 通知开关 -->
                <RowDefinition Height="*"/>
                <!-- 兑换码列表 -->
            </Grid.RowDefinitions>

            <!-- 国服/国际服切换 -->
            <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,16">
                <ui:Button Command="{Binding SelectCnServerCommand}" Margin="0,0,6,0" HorizontalAlignment="Stretch">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Setter Property="Content" Value="{helpers:Trans '国服'}" />
                            <Setter Property="Icon" Value="{ui:SymbolIcon Globe24}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCnServerSelected}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Command="{Binding SelectGlobalServerCommand}" Margin="6,0,0,0" HorizontalAlignment="Stretch">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Setter Property="Content" Value="{helpers:Trans '国际服'}" />
                            <Setter Property="Icon" Value="{ui:SymbolIcon Globe24}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCnServerSelected}" Value="False">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </UniformGrid>

            <!-- 通知开关 -->
            <Border Grid.Row="1" Background="{ui:ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="24" Margin="0,0,12,0" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{helpers:Trans '兑换码更新通知'}" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{helpers:Trans '开启后有新的兑换码时提醒'}" FontTypography="Caption" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsNotificationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 兑换码列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="{Binding Title}" FontTypography="Subtitle" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Codes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 复制与一键兑换按钮区 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">

                                        <!-- 复制按钮 -->
                                        <ui:Button MinWidth="80" Margin="0,0,8,0"
                                                   Command="{Binding DataContext.CopyCodesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="{helpers:Trans '复制'}"/>
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Copy24}"/>
                                                    <Setter Property="Appearance" Value="Secondary"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                            <Setter Property="Content" Value="{helpers:Trans '已复制'}"/>
                                                            <Setter Property="Icon" Value="{ui:SymbolIcon Checkmark24}"/>
                                                            <Setter Property="Appearance" Value="Primary"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>

                                        <!-- 一键兑换按钮 -->
                                        <ui:Button Content="{helpers:Trans '一键兑换'}"
                                                   Command="{Binding DataContext.AutoRedeemGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Primary"
                                                   IsEnabled="{Binding DataContext.CanStartRedeem, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>