<ui:FluentWindow x:Class="TrustNTE.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:TrustNTE.Views.Pages"
        xmlns:helpers="clr-namespace:TrustNTE.Helpers"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        Title="TrustNTE · 解放双手，不解放乐趣！" Height="700" Width="1000"
        Icon="pack://application:,,,/Assets/titlelogo.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 隐藏系统原生按钮，使用全自绘的 5 个按钮 -->
        <ui:TitleBar Grid.Row="0" Title="TrustNTE · 解放双手，不解放乐趣！"
                     ShowMinimize="False" ShowMaximize="False" ShowClose="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/titlelogo.ico" />
            </ui:TitleBar.Icon>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Stretch">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="46"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- 礼包 -->
                    <Button ToolTip="查看最新兑换码"
                            Command="{Binding DataContext.ManualOpenRedeemWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Gift24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <!-- 缩小到托盘 -->
                    <Button ToolTip="缩小到托盘" Click="MinimizeToTray_Click">
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <!-- 最小化 -->
                    <Button ToolTip="最小化" Click="MinimizeWindow_Click">
                        <ui:SymbolIcon Symbol="Subtract24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <!-- 最大化/还原 -->
                    <Button ToolTip="最大化" Click="MaximizeWindow_Click">
                        <ui:SymbolIcon x:Name="MaxIcon" Symbol="Square24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <!-- 关闭：悬浮单独变红 -->
                    <Button ToolTip="关闭" Click="CloseWindow_Click">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#E81123" />
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="True"
                           OpenPaneLength="160">

            <!-- 顶部菜单 -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{helpers:Trans '启动'}" TargetPageType="{x:Type pages:StartPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:Trans '实时触发'}" TargetPageType="{x:Type pages:RealTimePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Timer24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:Trans '独立任务'}" TargetPageType="{x:Type pages:TaskSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TaskListSquareLtr24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- 全自动 (包含 5 个子菜单) -->
                <ui:NavigationViewItem Content="{helpers:Trans '全自动'}" Tag="None">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Bot24" />
                    </ui:NavigationViewItem.Icon>

                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{helpers:Trans '调度器'}" TargetPageType="{x:Type pages:DispatcherPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon Source="/Views/Windows/Assets/icon_scheduler.png" Width="16" Height="16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem Content="{helpers:Trans 'JS 脚本'}" TargetPageType="{x:Type pages:ScriptPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon Source="/Views/Windows/Assets/icon_js.png" Width="16" Height="16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem Content="{helpers:Trans '地图追踪'}" Tag="MapPage" IsEnabled="False">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon Source="/Views/Windows/Assets/icon_map.png" Width="16" Height="16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem Content="{helpers:Trans '录制回放'}" TargetPageType="{x:Type pages:RecordPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon Source="/Views/Windows/Assets/icon_record.png" Width="16" Height="16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem Content="{helpers:Trans '等待更新'}" Tag="None" IsEnabled="False">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon Source="/Views/Windows/Assets/icon_update.png" Width="16" Height="16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:Trans '辅助操控'}" TargetPageType="{x:Type pages:AssistantPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="XboxController24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:Trans '快捷键'}" TargetPageType="{x:Type pages:HotKeySettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 底部菜单（设置沉底） -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{helpers:Trans '设置'}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- ══════════ 兑换码悬浮 Toast（替代原 InfoBar，仿 BGI 卡片样式） ══════════ -->
        <Border x:Name="RedeemToast"
                Grid.Row="1"
                Margin="0,12,16,0"
                Padding="14,12"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Panel.ZIndex="99"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#26FFFFFF"
                Background="#F01E1E1E"
                Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>

            <!-- 整卡可点：走原有"打开兑换码窗口"命令（点 X 不会误触发，Button 已吞掉事件） -->
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding DataContext.ManualOpenRedeemWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Border.InputBindings>

            <!-- 显隐 + 滑入动画 + 悬停变色（全部内聚在 Style，无外部资源依赖） -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F62A2A2A"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRedeemInfoBarOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                        <!--    复 MC4011：使用属性路径而非 TargetName -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="48" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <!--    复 MC4011：使用属性路径而非 TargetName -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="48" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastSlide" X="48"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧图标 -->
                <Border Width="34" Height="34" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Gift24" FontSize="18" Foreground="White"/>
                </Border>

                <!-- 文案 -->
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{helpers:Trans '有新的兑换码可用'}"
                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{helpers:Trans '点击查看详情'}"
                               FontSize="12" Margin="0,3,0,0" Foreground="#A0FFFFFF"/>
                </StackPanel>

                <!-- 关闭 X -->
                <Button Grid.Column="2" VerticalAlignment="Center" Focusable="False"
                        Click="RedeemToastClose_Click" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Xbg" Background="Transparent" CornerRadius="4" Padding="4">
                                <ui:SymbolIcon x:Name="Xicon" Symbol="Dismiss24" FontSize="14" Foreground="#80FFFFFF"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Xbg" Property="Background" Value="#22FFFFFF"/>
                                    <Setter TargetName="Xicon" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 系统托盘图标 -->
        <tray:NotifyIcon x:Name="TrayIcon"
                         Icon="/Assets/titlelogo.ico"
                         TooltipText="TrustNTE - 解放双手"
                         MenuOnRightClick="True"
                         LeftDoubleClick="OnNotifyIconLeftDoubleClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="显示主界面" Click="OnShowWindowClick" />
                    <MenuItem Header="退出" Click="OnExitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>